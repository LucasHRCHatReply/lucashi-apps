---
// Gabarit d'une page d'outil (contrat, section 3). Le slot reçoit l'outil (Outil.astro) ; le corps du .md,
// la FAQ, les sources, « Autres outils » et l'encart App Store sont rendus ici.
import { render } from 'astro:content';
import Base from './Base.astro';
import TuileOutil from '../composants/TuileOutil.astro';
import { fiches, autreLangue, autresOutils, chemin, cheminHub, cheminOg, dateLongue, type Fiche } from '../lib/outils';
import { troisApps, srcIcone } from '../lib/apps';
import { url, AUTEUR } from '../lib/site';

interface Props { fiche: Fiche }
const { fiche } = Astro.props;
const d = fiche.data;
const lang = d.lang;
const toutes = await fiches();
const autre = autreLangue(fiche, toutes);
const autres = autresOutils(fiche, toutes);
const { Content } = await render(fiche);
const monChemin = chemin(fiche);

const T = lang === 'fr'
  ? { accueil: 'Accueil', outils: 'Outils', fil: 'Fil d’Ariane', local: 'Traité sur votre appareil — rien n’est envoyé', calcul: 'Calcul instantané, sans inscription',
      faq: 'Questions fréquentes', sources: 'Sources', maj: 'Mis à jour le', autres: 'Autres outils',
      storeTitre: 'Des petites apps Mac, gratuites aussi', storeTexte: 'Faites pour moi, partagées telles quelles. Sans compte, sans télémétrie.', storeBouton: 'Voir les apps', outil: 'Outil' }
  : { accueil: 'Home', outils: 'Tools', fil: 'Breadcrumb', local: 'Processed on your device — nothing is uploaded', calcul: 'Instant calculation, no sign-up',
      faq: 'Frequently asked questions', sources: 'Sources', maj: 'Last updated', autres: 'More tools',
      storeTitre: 'Small Mac apps, free too', storeTexte: 'Made for myself, shared as they are. No account, no telemetry.', storeBouton: 'See the apps', outil: 'Tool' };

const CATEGORIE_SCHEMA = { images: 'MultimediaApplication', documents: 'BusinessApplication', argent: 'FinanceApplication', pratique: 'UtilitiesApplication' } as const;
const jsonld: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: d.h1, description: d.description, url: url(monChemin), inLanguage: lang,
    applicationCategory: CATEGORIE_SCHEMA[d.categorie], operatingSystem: 'Any', browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true, offers: { '@type': 'Offer', price: 0, priceCurrency: lang === 'fr' ? 'EUR' : 'USD' },
    author: { '@type': 'Person', name: AUTEUR }, dateModified: d.mis_a_jour.toISOString().slice(0, 10), keywords: d.mots_cles.join(', '),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.accueil, item: url('/') },
      { '@type': 'ListItem', position: 2, name: T.outils, item: url(cheminHub(lang)) },
      { '@type': 'ListItem', position: 3, name: d.nom_court, item: url(monChemin) },
    ],
  },
];
if (d.faq.length) jsonld.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
});

const alternates: { fr?: string; en?: string } = { [lang]: monChemin, ...(autre ? { [autre.data.lang]: chemin(autre) } : {}) };
---
<Base lang={lang} titre={d.titre} description={d.description} chemin={monChemin} alternates={alternates} og={cheminOg(fiche)} jsonld={jsonld} courant="outils" outilId={d.id}>
  <header class="o-entete wrap">
    <div class="o-entete__panneau">
      <nav class="o-fil" aria-label={T.fil}>
        <ol>
          <li><a href="/">{T.accueil}</a></li>
          <li><a href={cheminHub(lang)}>{T.outils}</a></li>
          <li aria-current="page">{d.nom_court}</li>
        </ol>
      </nav>
      <h1>{d.h1}</h1>
      <p class="o-phrase">{d.phrase}</p>
      <p class="o-pastille"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>{d.calcul ? T.calcul : T.local}</p>
    </div>
  </header>
  <main class="o-plat" id="contenu">
    <div class="wrap">
      <section class="o-outil" aria-label={T.outil}><slot /></section>
      <article class="o-texte"><Content /></article>
      {d.faq.length > 0 && (
        <section class="o-faq" aria-labelledby="faq-titre">
          <h2 id="faq-titre">{T.faq}</h2>
          {d.faq.map((f) => (<><h3>{f.q}</h3><p>{f.r}</p></>))}
        </section>
      )}
      {d.sources.length > 0 && (
        <section class="o-sources" aria-labelledby="sources-titre">
          <h2 id="sources-titre">{T.sources}</h2>
          <ul>{d.sources.map((s) => typeof s === 'string' ? <li>{s}</li> : <li>{s.url ? <a href={s.url} rel="noopener">{s.titre}</a> : s.titre}</li>)}</ul>
        </section>
      )}
      <p class="o-maj">{T.maj} {dateLongue(d.mis_a_jour, lang)}</p>
      {autres.length > 0 && (
        <section class="o-autres" aria-labelledby="autres-titre">
          <h2 id="autres-titre">{T.autres}</h2>
          <div class="o-grille">{autres.map((f) => <TuileOutil fiche={f} />)}</div>
        </section>
      )}
      <aside class="o-appstore" aria-label="App Store">
        <div class="o-appstore__icones">{troisApps().map((a) => <img src={srcIcone(a)} alt="" width="56" height="56" loading="lazy" />)}</div>
        <div class="o-appstore__txt"><b>{T.storeTitre}</b><span>{T.storeTexte}</span></div>
        <a class="o-btn o-btn--principal" href="/#apps">{T.storeBouton}</a>
      </aside>
    </div>
  </main>
  <script>
    import { compter } from '../lib/compteur';
    const id = document.body.dataset.outil;
    if (id) compter('vue', id);
  </script>
</Base>
